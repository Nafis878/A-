# Results are regenerated by scripts/run_queue.py; never commit them.
/results/
/data/
/checkpoints/
wandb/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

*.bin
*.npy
*.uint16

# 86 h of CPU compute lives here. Keep the evidence (result.json), drop the
# bulk (checkpoints, loss traces): git cannot re-include a file whose parent
# directory is excluded, so the directories must stay un-ignored.
/ladder_runs/*
!/ladder_runs/*/
/ladder_runs/*/*
!/ladder_runs/*/result.json
ladder.log

# Same pattern as ladder_runs: keep the measured profiles, drop the weights.
/carry_runs/*
!/carry_runs/*.json
!/carry_runs/*/
/carry_runs/*/*
carry.log

# text8 is 95 MB of corpus; re-fetched by the study, never committed.
/lm_data/
/lm_runs/*
!/lm_runs/*/
/lm_runs/*/*
!/lm_runs/*/result.json
/breadth_runs/*
!/breadth_runs/*/
/breadth_runs/*/*
!/breadth_runs/*/result.json
/depth_runs/*
!/depth_runs/*/
/depth_runs/*/*
!/depth_runs/*/result.json

*.log
/lm_ind_runs/*
!/lm_ind_runs/*/
/lm_ind_runs/*/*
!/lm_ind_runs/*/result.json
