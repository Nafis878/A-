# Results are regenerated by scripts/run_queue.py; never commit them.
/results/
/data/
/checkpoints/
wandb/

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/

*.bin
*.npy
*.uint16

# 86 h of CPU compute lives here. Keep the evidence (result.json), drop the
# bulk (checkpoints, loss traces): git cannot re-include a file whose parent
# directory is excluded, so the directories must stay un-ignored.
/ladder_runs/*
!/ladder_runs/*/
/ladder_runs/*/*
!/ladder_runs/*/result.json
ladder.log
